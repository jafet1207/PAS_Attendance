# Puerto del servidor backend
PORT=5000

# Base de datos PostgreSQL (Neon)
DATABASE_URL=postgresql://usuario:password@host/basededatos?sslmode=require
TEST_DATABASE_URL=postgresql://usuario:password@host/basededatos_test?sslmode=require

# Secretos y autenticación
SECRET_KEY=clave-secreta-para-firmar-sesiones-y-tokens
CRON_SECRET=clave-secreta-para-el-cron-job
COORDINADOR_PASSWORD=coordinador123

# Envío real de correos vía Gmail SMTP (opcional: si no se configuran, se usa MockMailer simulado)
GMAIL_USER=tu-correo@gmail.com
GMAIL_APP_PASSWORD=contraseña-de-aplicacion-de-16-caracteres

# URL pública base del backend, usada para construir los enlaces de confirmación en los correos
APP_BASE_URL=http://localhost:5000
